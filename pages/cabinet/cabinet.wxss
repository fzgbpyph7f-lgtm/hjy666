.page {
  padding: 32rpx;
  padding-bottom: 80rpx;
}

/* ============ 看板 ============ */
.dashboard {
  position: relative;
  display: flex;
  align-items: center;
  padding: 44rpx 0;
  background: linear-gradient(135deg, #4f7cff 0%, #7aa2ff 40%, #a08fff 70%, #4f7cff 100%);
  background-size: 300% 300%;
  animation: gradientFlow 12s ease infinite;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(79, 124, 255, 0.28);
  overflow: hidden;
}
.dash-glow {
  position: absolute;
  top: -120rpx; right: -80rpx;
  width: 340rpx; height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.35), transparent 70%);
  pointer-events: none;
}
.dash-ring {
  position: absolute;
  bottom: -100rpx; left: -60rpx;
  width: 220rpx; height: 220rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.28);
  pointer-events: none;
}

.dash-item { flex: 1; text-align: center; position: relative; }
.dash-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.dash-num.danger  { color: #ffe0e0; }
.dash-num.warning { color: #fff3cc; }
.dash-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}
.dash-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ============ 筛选 ============ */
.filter-row {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}
.filter-item {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #667;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(79, 124, 255, 0.06);
  transition: all 0.25s cubic-bezier(0.22, 0.9, 0.28, 1);
}
.filter-item.active {
  background: linear-gradient(135deg, #4f7cff, #7aa2ff);
  color: #fff;
  font-weight: 600;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(79, 124, 255, 0.32);
}

/* ============ 空状态：CSS 漂浮胶囊 ============ */
.empty {
  margin-top: 100rpx;
  text-align: center;
  animation: slideUp 0.5s ease both;
}

.empty-illust {
  position: relative;
  width: 420rpx;
  height: 300rpx;
  margin: 0 auto 30rpx;
}

/* 胶囊本体：上半蓝，下半白，中间有分界线 */
.capsule {
  position: absolute;
  width: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg,
    #4f7cff 0%,
    #6b8dff 48.5%,
    #dbe6ff 49.5%,
    #e8eeff 50.5%,
    #ffffff 100%);
  box-shadow:
    0 12rpx 28rpx rgba(79, 124, 255, 0.22),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.7);
}
.cap-1 {
  height: 160rpx;
  left: 40rpx;
  top: 60rpx;
  animation: floatRot1 3.2s ease-in-out infinite;
}
.cap-2 {
  height: 200rpx;
  left: 180rpx;
  top: 10rpx;
  animation: floatRot2 3.6s ease-in-out infinite;
}
.cap-3 {
  height: 140rpx;
  left: 320rpx;
  top: 80rpx;
  animation: floatRot3 3.0s ease-in-out infinite;
}

/* 底部投影 */
.empty-base {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 24rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(79, 124, 255, 0.18), transparent 70%);
  animation: ringPulse 3.2s ease-in-out infinite;
}

.empty-text {
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #8890a6;
  font-weight: 500;
}
.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b0b8ca;
}

/* ============ 药品卡片 ============ */
.drug-item {
  position: relative;
  padding: 28rpx 32rpx 28rpx 44rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  animation: slideUp 0.5s cubic-bezier(0.22, 0.9, 0.28, 1) both;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.drug-item:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 14rpx rgba(79, 124, 255, 0.15);
}

/* 左侧色条，颜色随状态变化 */
.side-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 28rpx 0 0 28rpx;
}
.drug-item.expired .side-bar { background: linear-gradient(180deg, #ff5a5a, #ff8a8a); }
.drug-item.warning .side-bar { background: linear-gradient(180deg, #ffa726, #ffc266); }
.drug-item.normal  .side-bar { background: linear-gradient(180deg, #22c55e, #5ee08a); }

.drug-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.drug-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: pulseGlow 2.4s ease-in-out infinite;
}
.status-dot.expired { background: #ff5a5a; }
.status-dot.warning { background: #ffa726; }
.status-dot.normal  { background: #22c55e; }

.drug-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.meta-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #eef3ff, #e0e9ff);
  color: #4f7cff;
  font-weight: 600;
}
.meta-text {
  font-size: 26rpx;
  color: #8890a6;
}

.drug-bottom {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f4f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.expiry { font-size: 26rpx; }
.expiry.expired { color: #ff5a5a; font-weight: 600; }
.expiry.warning { color: #ffa726; font-weight: 600; }
.expiry.normal  { color: #8890a6; }

.delete-btn {
  font-size: 26rpx;
  color: #b0b8ca;
  padding: 8rpx 16rpx;
  transition: color 0.2s ease, transform 0.2s ease;
}
.delete-btn:active {
  color: #ff5a5a;
  transform: scale(0.94);
}

/* ============ 清空 ============ */
.clear-btn {
  margin-top: 40rpx;
  background: #ffffff;
  color: #ff5a5a;
  border-radius: 999rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 90, 90, 0.10);
  transition: transform 0.18s ease;
}
.btn-pressed {
  transform: scale(0.965);
}
/* ============ 健康评分卡 ============ */
.health-card {
  margin-top: 24rpx;
  padding: 32rpx 36rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(79, 124, 255, 0.10);
  animation: slideUp 0.5s ease both;
}
.health-card.excellent { border-left: 8rpx solid #22c55e; }
.health-card.good      { border-left: 8rpx solid #4f7cff; }
.health-card.warning   { border-left: 8rpx solid #ffa726; }
.health-card.danger    { border-left: 8rpx solid #ff5a5a; }

.health-left { flex: 1; }
.health-label {
  font-size: 24rpx;
  color: #99a3b8;
  letter-spacing: 1rpx;
}
.health-score {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}
.score-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #1a1a2e;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.score-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #99a3b8;
}
.health-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #667;
}
.health-card.excellent .health-tip { color: #16a34a; }
.health-card.good      .health-tip { color: #4f7cff; }
.health-card.warning   .health-tip { color: #d48806; }
.health-card.danger    .health-tip { color: #d4380d; }

/* 右侧环形进度 */
.health-right { width: 140rpx; height: 140rpx; position: relative; }
.ring-outer {
  width: 100%; height: 100%;
  border-radius: 50%;
  background: conic-gradient(#4f7cff 0deg, #e6ecff 0deg);
  position: relative;
}
.health-card.excellent .ring-outer { background: conic-gradient(#22c55e 0deg, #e6f9ef 0deg); }
.health-card.good      .ring-outer { background: conic-gradient(#4f7cff 0deg, #e6ecff 0deg); }
.health-card.warning   .ring-outer { background: conic-gradient(#ffa726 0deg, #fff8e6 0deg); }
.health-card.danger    .ring-outer { background: conic-gradient(#ff5a5a 0deg, #fff1f0 0deg); }

.ring-progress {
  position: absolute;
  top: -2rpx; left: -2rpx; right: -2rpx; bottom: -2rpx;
  border-radius: 50%;
  background: transparent;
  pointer-events: none;
}
.ring-mask {
  position: absolute;
  top: 14rpx; left: 14rpx; right: 14rpx; bottom: 14rpx;
  border-radius: 50%;
  background: #fff;
}