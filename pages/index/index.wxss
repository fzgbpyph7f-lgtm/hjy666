/**index.wxss**/
.page {
  padding: 0 32rpx 60rpx;
  overflow: hidden;
}

/* ============ Hero ============ */
.hero {
  position: relative;
  margin: 0 -32rpx 32rpx;
  padding: 56rpx 48rpx 92rpx;
  background: linear-gradient(135deg, #4f7cff 0%, #7aa2ff 35%, #a08fff 70%, #4f7cff 100%);
  background-size: 300% 300%;
  animation: gradientFlow 12s ease infinite;
  border-bottom-left-radius: 56rpx;
  border-bottom-right-radius: 56rpx;
  color: #fff;
  overflow: hidden;
}

/* 光斑装饰 */
.hero-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.blob-1 {
  width: 360rpx; height: 360rpx;
  top: -140rpx; right: -100rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.38), transparent 70%);
}
.blob-2 {
  width: 240rpx; height: 240rpx;
  bottom: -120rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(160, 143, 255, 0.55), transparent 70%);
}

/* 描边圆环 */
.hero-ring {
  position: absolute;
  width: 220rpx; height: 220rpx;
  top: 60rpx; right: -70rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.35);
  animation: ringPulse 4s ease-in-out infinite;
}

.hero-content { position: relative; }

.hero-badge {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.4);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  animation: fadeInDown 0.6s ease both;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 3rpx;
  animation: fadeInDown 0.6s ease 0.08s both;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.92;
  animation: fadeInDown 0.6s ease 0.16s both;
}

.hero-chips {
  margin-top: 28rpx;
  display: flex;
  gap: 14rpx;
  animation: fadeInDown 0.6s ease 0.24s both;
}
.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.32);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ============ 拍照卡片 ============ */
.camera-card {
  position: relative;
  margin-top: -56rpx;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #cfd8ec;
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  animation: pulseGlow 2.8s ease-in-out infinite;
}
.camera-pressed {
  transform: scale(0.975);
  box-shadow: 0 4rpx 12rpx rgba(79, 124, 255, 0.18);
}

/* 四角扫描框 */
.corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-color: #4f7cff;
  border-style: solid;
  border-width: 0;
  pointer-events: none;
}
.corner.tl { top: 22rpx; left: 22rpx;    border-top-width: 6rpx;    border-left-width: 6rpx;  border-top-left-radius: 12rpx; }
.corner.tr { top: 22rpx; right: 22rpx;   border-top-width: 6rpx;    border-right-width: 6rpx; border-top-right-radius: 12rpx; }
.corner.bl { bottom: 22rpx; left: 22rpx;  border-bottom-width: 6rpx; border-left-width: 6rpx;  border-bottom-left-radius: 12rpx; }
.corner.br { bottom: 22rpx; right: 22rpx; border-bottom-width: 6rpx; border-right-width: 6rpx; border-bottom-right-radius: 12rpx; }

/* 扫描线 */
.scan-line {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, #4f7cff, transparent);
  box-shadow: 0 0 16rpx rgba(79, 124, 255, 0.9);
  animation: scanMove 2.6s ease-in-out infinite;
  pointer-events: none;
}

.preview { width: 100%; height: 100%; }

.placeholder { text-align: center; }

/* 纯 CSS 相机图标 */
.camera-shape {
  position: relative;
  width: 140rpx;
  height: 108rpx;
  margin: 0 auto 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #4f7cff, #7aa2ff);
  box-shadow: 0 12rpx 28rpx rgba(79, 124, 255, 0.28);
  animation: fadeInDown 0.6s ease 0.2s both;
}
.camera-shape::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: 40rpx;
  width: 60rpx;
  height: 22rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(135deg, #4f7cff, #7aa2ff);
}
.camera-shape::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 10rpx #dbe6ff;
}

.main-text { font-size: 32rpx; color: #223; font-weight: 600; }
.hint { font-size: 24rpx; color: #a3adc2; margin-top: 12rpx; }

/* ============ 加载 ============ */
.loading-card {
  margin-top: 30rpx;
  padding: 48rpx;
  text-align: center;
  animation: slideUp 0.4s ease both;
}
.pill-loader {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  height: 60rpx;
  margin-bottom: 22rpx;
}
.pill {
  width: 20rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #4f7cff, #a08fff);
  animation: pillBounce 1.2s ease-in-out infinite;
}
.pill:nth-child(1) { animation-delay: 0s; }
.pill:nth-child(2) { animation-delay: 0.15s; }
.pill:nth-child(3) { animation-delay: 0.3s; }

.loading-text {
  font-size: 28rpx;
  color: #4f7cff;
  letter-spacing: 1rpx;
}

/* ============ 结果卡片 ============ */
.result-card {
  position: relative;
  margin-top: 30rpx;
  padding: 0 0 36rpx;
  overflow: hidden;
  animation: slideUp 0.45s cubic-bezier(0.22, 0.9, 0.28, 1) both;
}

.result-deco {
  position: absolute;
  right: -80rpx;
  top: 40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(79, 124, 255, 0.08), transparent 70%);
  pointer-events: none;
}

.status-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 26rpx 32rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  overflow: hidden;
}
.status-bar.expired { background: linear-gradient(135deg, #ff5a5a, #ff8a8a); }
.status-bar.warning { background: linear-gradient(135deg, #ffa726, #ffc266); }
.status-bar.normal  { background: linear-gradient(135deg, #22c55e, #5ee08a); }

.status-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.35);
}

.status-shine {
  position: absolute;
  top: 0; left: 0;
  width: 40%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.55), transparent);
  transform: translateX(-120%);
  animation: shineSweep 1.6s ease-in-out 0.35s;
  pointer-events: none;
}

.drug-name {
  padding: 32rpx 32rpx 16rpx;
  font-size: 42rpx;
  font-weight: bold;
  color: #1a1a2e;
  animation: slideUp 0.45s ease 0.06s both;
}

.tag-row {
  padding: 0 32rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  animation: slideUp 0.45s ease 0.12s both;
}
.tag {
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.tag.category {
  background: linear-gradient(135deg, #eef3ff, #e0e9ff);
  color: #4f7cff;
  font-weight: 600;
}
.tag.usage {
  background: #f2f4f8;
  color: #667;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #f2f4f8;
}
.label { color: #99a3b8; font-size: 28rpx; }
.value { color: #1a1a2e; font-size: 28rpx; font-weight: 600; }

.action-tip {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #fff1f0;
  color: #d4380d;
  font-size: 26rpx;
  border-radius: 16rpx;
  line-height: 1.6;
  animation: slideUp 0.45s ease 0.18s both;
}
.warning-tip { background: #fff8e6; color: #d48806; }

.btn-primary {
  margin: 32rpx 32rpx 0;
  background: linear-gradient(135deg, #e1251b, #ff5a4d);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(225, 37, 27, 0.28);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.btn-ghost {
  margin: 20rpx 32rpx 0;
  background: #f2f4f8;
  color: #667;
  border-radius: 999rpx;
  font-size: 28rpx;
  transition: transform 0.18s ease;
}
.btn-pressed {
  transform: scale(0.965);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.12);
}

.footer-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a3adc2;
}