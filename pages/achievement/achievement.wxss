.page {
  padding: 32rpx;
  padding-bottom: 80rpx;
}

/* ============ 顶部贡献卡 ============ */
.hero-card {
  position: relative;
  padding: 44rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #4f7cff 0%, #7aa2ff 40%, #a08fff 70%, #4f7cff 100%);
  background-size: 300% 300%;
  animation: gradientFlow 12s ease infinite;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(79, 124, 255, 0.30);
  color: #fff;
  overflow: hidden;
}
.hero-blob {
  position: absolute;
  top: -140rpx; right: -100rpx;
  width: 360rpx; height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.35), transparent 70%);
  pointer-events: none;
}
.hero-ring {
  position: absolute;
  bottom: -80rpx; left: -60rpx;
  width: 220rpx; height: 220rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.28);
  animation: ringPulse 4s ease-in-out infinite;
}

.hero-label {
  position: relative;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.9;
  animation: fadeInDown 0.5s ease both;
}

.hero-stat {
  position: relative;
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  animation: fadeInDown 0.6s ease 0.08s both;
}
.stat-item { display: flex; align-items: baseline; }
.stat-num {
  font-size: 96rpx;
  font-weight: bold;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.stat-unit {
  margin-left: 8rpx;
  font-size: 32rpx;
  opacity: 0.85;
}
.stat-text {
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-metrics {
  position: relative;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  animation: fadeInDown 0.6s ease 0.16s both;
}
.metric { flex: 1; text-align: center; }
.metric-num {
  font-size: 40rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
}
.metric-unit {
  font-size: 22rpx;
  margin-left: 4rpx;
  opacity: 0.85;
}
.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
.metric-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.3);
}

/* ============ 章节标题 ============ */
.section-title {
  margin: 44rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
  padding-left: 20rpx;
  position: relative;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4f7cff, #a08fff);
}

/* ============ 勋章 ============ */
.medal-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.medal-item {
  width: calc((100% - 40rpx) / 3);
  text-align: center;
  transition: opacity 0.3s ease;
}
.medal-item.locked { opacity: 0.4; }
.medal-item.locked .medal-circle {
  filter: grayscale(1);
}

.medal-circle {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 8rpx 22rpx rgba(79, 124, 255, 0.22);
}
.medal-circle.green  { background: linear-gradient(135deg, #5ee08a, #22c55e); }
.medal-circle.teal   { background: linear-gradient(135deg, #4f7cff, #22c5c5); }
.medal-circle.blue   { background: linear-gradient(135deg, #4f7cff, #7aa2ff); }
.medal-circle.gold   { background: linear-gradient(135deg, #f5b74a, #ffd96b); }

.medal-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  border: 2rpx solid rgba(255,255,255,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.medal-ring {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  border-bottom-color: transparent;
  border-right-color: transparent;
  transform: rotate(-45deg);
}

.medal-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.medal-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #99a3b8;
}

/* ============ 空状态 ============ */
.empty-orders {
  text-align: center;
  padding: 60rpx 0;
  animation: slideUp 0.5s ease both;
}
.empty-ring {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 8rpx dashed #cfd8ec;
  animation: ringPulse 3s ease-in-out infinite;
}
.empty-text { font-size: 28rpx; color: #8890a6; }
.empty-hint { margin-top: 10rpx; font-size: 24rpx; color: #b0b8ca; }

/* ============ 订单卡片 ============ */
.order-item {
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  animation: slideUp 0.5s cubic-bezier(0.22, 0.9, 0.28, 1) both;
}
.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
}
.order-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.order-status.pending {
  background: #fff8e6;
  color: #d48806;
}
.order-status.done {
  background: #e6f9ef;
  color: #16a34a;
}

.order-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.meta-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #eef3ff, #e0e9ff);
  color: #4f7cff;
  font-weight: 600;
}
.meta-time {
  font-size: 24rpx;
  color: #99a3b8;
}

/* ============ CTA ============ */
.cta-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #4f7cff, #7aa2ff);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(79, 124, 255, 0.28);
  transition: transform 0.18s ease;
}
.btn-pressed { transform: scale(0.965); }